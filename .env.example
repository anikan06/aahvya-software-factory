# Copy to .env for local development. Placeholders only; real values for local
# development are listed in infra/README.md. Never commit .env.
FACTORY_ENV=LOCAL
DATABASE_URL=postgres://factory_api:<factory_api_password>@localhost:5432/factory
MIGRATION_DATABASE_URL=postgres://factory_migrator:<factory_migrator_password>@localhost:5432/factory
OIDC_ISSUER=http://localhost:8080/realms/factory
OIDC_AUDIENCE=factory-api
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=factory-artifacts
