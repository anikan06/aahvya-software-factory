{
  "name": "aahvya-software-factory",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v --remove-orphans",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m db/migrations -d MIGRATION_DATABASE_URL --no-verbose up",
    "db:migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m db/migrations -d MIGRATION_DATABASE_URL --no-verbose down",
    "db:migrate:create": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m db/migrations -d MIGRATION_DATABASE_URL --no-verbose create --migration-file-language sql --template-file-name db/migration-template.sql",
    "db:codegen": "node --env-file-if-exists=.env node_modules/kysely-codegen/dist/cli/bin.js --dialect postgres --url 'env(MIGRATION_DATABASE_URL)' --out-file libs/infrastructure/postgres/src/generated/db.ts --exclude-pattern 'public.pgmigrations'",
    "db:verify": "bash tools/scripts/db-verify.sh",
    "dev": "bash tools/scripts/dev.sh"
  },
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/webpack": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "1.64.1",
    "@schematics/angular": "22.2.3",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@testcontainers/postgresql": "12.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@typescript-eslint/utils": "8.72.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "1.8.3",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "jest-environment-node": "30.3.0",
    "jest-preset-angular": "17.0.3",
    "jest-util": "30.3.0",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0",
    "nx": "23.3.0",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
